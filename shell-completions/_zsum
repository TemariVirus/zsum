#compdef zsum

_zsum() {
    _arguments \
        '(-a --algo)'{-a,--algo}'[The hashing algorithm to use]:algo:((
            blake2b_128
            blake2b_160
            blake2b_256
            blake2b_384
            blake2b_512
            blake2s_128
            blake2s_160
            blake2s_224
            blake2s_256
            blake3
            md5
            sha1
            sha224
            sha256
            sha384
            sha512
            sha3_224
            sha3_256
            sha3_384
            sha3_512
        ))' \
        '(-c --checksum -l --list)'{-c,--checksum}'[The expected hash to check against]:hash:' \
        '(-h --help)'{-h,--help}'[Print the help message]' \
        '(-l --list -c --checksum)'{-l,--list}'[List all files in the directory and their hashes]' \
        '(-v --verbose)'{-v,--verbose}'[Print stats to stderr]' \
        '--version[Print program version]' \
        '1:path:_files'
}

compdef _zsum zsum
